#!/usr/bin/env bash
# Enregistrez une copie de ce modèle dans un espace privé du laboratoire,
# adaptez les chemins puis indiquez-la avec LAB_CONFIG=/chemin/prive/lab.env.

# Initialisation et exécutables Cadence
CADENCE_SETUP=/chemin/vers/le/setup_cadence
XRUN_BIN=xrun
GENUS_BIN=genus
INNOVUS_BIN=innovus

# Profil technologique de référence
TECHNOLOGY_NAME=XH018
TECHNOLOGY_STACK=xx31
STDCELL_FAMILY=JIHD
STDCELL_SITE=core_jihd
SIGNAL_BOTTOM_LAYER=MET1
SIGNAL_TOP_LAYER=MET3
POWER_HORIZONTAL_LAYER=MET3
POWER_VERTICAL_LAYER=METTP
STDCELL_POWER_PIN=vddi
STDCELL_GROUND_PIN=gndi

# Genus. Les listes Liberty et LEF utilisent ':' comme séparateur.
GENUS_LIBERTY_TC=/chemin/vers/la/liberty_typique
GENUS_LIBERTY_BC=/chemin/vers/la/liberty_rapide
GENUS_LIBERTY_WC=/chemin/vers/la/liberty_lente
GENUS_LEF_FILES=/chemin/vers/tech.lef:/chemin/vers/stdcell.lef
GENUS_QRC_TC=/chemin/vers/qrc_typique
GENUS_QRC_BC=/chemin/vers/qrc_min
GENUS_QRC_WC=/chemin/vers/qrc_max
GENUS_TEMPERATURE_TC=25
GENUS_TEMPERATURE_BC=-40
GENUS_TEMPERATURE_WC=125

# Innovus
INNOVUS_TECH_LEF=/chemin/vers/tech.lef
INNOVUS_STDCELL_LEF=/chemin/vers/stdcell.lef
INNOVUS_LIBERTY_TC=/chemin/vers/la/liberty_typique
INNOVUS_LIBERTY_BC=/chemin/vers/la/liberty_rapide
INNOVUS_LIBERTY_WC=/chemin/vers/la/liberty_lente
INNOVUS_QRC_TC=/chemin/vers/qrc_typique
INNOVUS_QRC_BC=/chemin/vers/qrc_min
INNOVUS_QRC_WC=/chemin/vers/qrc_max
INNOVUS_STREAM_MAP=/chemin/vers/la/stream_map
INNOVUS_STDCELL_GDS=/chemin/vers/le/gds_standard_cells

# Cellules physiques: chaque valeur est une liste séparée par des espaces.
INNOVUS_FILLER_CELLS="FEED25JIHD FEED15JIHD FEED10JIHD FEED7JIHD FEED5JIHD FEED3JIHD FEED2JIHD FEED1JIHD"
INNOVUS_TIE_HIGH_CELLS="LOGIC1DJIHD LOGIC1LVJIHD"
INNOVUS_TIE_LOW_CELLS="LOGIC0DJIHD LOGIC0LVJIHD"
INNOVUS_ANTENNA_CELLS="ANTENNACELLN2JIHD ANTENNACELLNP2JIHD ANTENNACELLP2JIHD"
INNOVUS_CTS_BUFFERS="BUJIHDX1 BUJIHDX2 BUJIHDX3 BUJIHDX4 BUJIHDX6 BUJIHDX8 BUJIHDX12"
INNOVUS_CTS_INVERTERS="INJIHDX0 INJIHDX1 INJIHDX2 INJIHDX3 INJIHDX4 INJIHDX6 INJIHDX8 INJIHDX12"

# Floorplan pédagogique. Les paramètres PG doivent être confirmés dans les
# règles du PDK avant le premier run réel.
CORE_UTILIZATION=0.60
CORE_ASPECT_RATIO=1.0
CORE_MIN_SIDE_UM=60.0
CORE_MARGIN_UM=20.0
PG_RING_WIDTH_UM=2.0
PG_RING_SPACING_UM=1.0
PG_RING_OFFSET_UM=2.0
