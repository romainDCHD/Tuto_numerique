#!/usr/bin/env bash

###### PATH generaux du projet ######
export TUTORIAL_ROOT="/home/validmgr/rduchadeau/Tuto_numerique"
# Pas sur si utile ici
# export LAB_CONFIG="$TUTORIAL_ROOt/config/lab_tsmc65n.env"

# Pour run Genus dans un mode basique (suffisant ici)
export GENUS_MODE="basic" 

###### PATH specifiques a une synthese ######
# Creation d un PATH unique avec date pour la synthese
export GENUS_RUN_DIR="$TUTORIAL_ROOT/rundir/genus/adder_pipeline_$(date +%Y%m%dT%H%M%SZ)"
export GENUS_TOP_MODULE="adder_pipeline"
export GENUS_FILELIST="$TUTORIAL_ROOT/examples/02_adder_pipeline/syn/rtl.f"
export GENUS_SDC="$TUTORIAL_ROOT/examples/02_adder_pipeline/syn/constraints.sdc "
# Creation d un fichier de log de la synthese
export GENUS_STAGE_STATUS="$GENUS_RUN_DIR/stage_status.tsv"

echo "PATH relatifs correctement exportés!"
